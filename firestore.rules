rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every user's assistants/events live under users/{uid}/... — only that user
    // may read or write their own subtree. Everything else (e.g. the server-only
    // rateLimits/{uid} docs written by the Admin SDK) has no matching rule here,
    // so it's denied to clients by default — exactly what we want, since only
    // Cloud Functions touch that collection.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
